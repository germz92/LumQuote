MONGODB_URI=mongodb://localhost:27017/LumetryMedia
PORT=3000
JWT_SECRET=your-jwt-secret
SESSION_SECRET=your-session-secret

# Cloudinary (profile photos — same account as LumDash recommended)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# LumDash stores users in the default "test" db; LumQuote uses LumetryMedia
LUMDASH_DB_NAME=test
# Optional: folder for LumQuote uploads (LumDash uses lumdash/profile-photos)
# CLOUDINARY_PROFILE_FOLDER=lumquote/profile-photos

# Stripe (invoice payments) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key
# Webhook signing secret for the /api/stripe/webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Public base URL used for shareable contract/invoice links and Stripe redirects
# (falls back to the request host when unset)
# APP_BASE_URL=https://your-app.onrender.com

# Google Calendar (company-wide booked+ project sync)
# Create an OAuth web client and enable the Calendar API.
# Register both redirect URIs on the Google Cloud client:
#   http://localhost:3000/api/admin/google-calendar/callback
#   https://lumquote.com/api/admin/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. Localhost is derived from the request host when unset.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/google-calendar/callback
